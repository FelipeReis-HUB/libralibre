<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="450.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.ufrn.imd.libralibre.controller.ListagemEmprestimosController">
   <top>
      <VBox alignment="CENTER" spacing="10.0">
         <padding>
            <Insets bottom="10.0" top="15.0" />
         </padding>
         <children>
            <Label text="Histórico de Empréstimos">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   
   <center>
      <TableView fx:id="tabelaEmprestimos" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colunaLivro" text="Livro" prefWidth="200.0" />
          <TableColumn fx:id="colunaUsuario" text="Usuário" prefWidth="150.0" />
          <TableColumn fx:id="colunaDataEmp" text="Data Empréstimo" prefWidth="120.0" style="-fx-alignment: CENTER;" />
          <TableColumn fx:id="colunaDataDev" text="Data Devolução" prefWidth="120.0" style="-fx-alignment: CENTER;" />
          <TableColumn fx:id="colunaStatus" text="Status" prefWidth="100.0" style="-fx-alignment: CENTER;" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>